# عمومی
PROJECT_NAME=womenswear

# JWT
JWT_SECRET=change_me_super_secret
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60

# User DB (PostgreSQL)
USER_DB_URL=postgresql+psycopg://user_service:user_service@user-db:5432/user_service

# Order DB (PostgreSQL)
ORDER_DB_URL=postgresql+psycopg://order_service:order_service@order-db:5432/order_service

# Payment DB (PostgreSQL)
PAYMENT_DB_URL=postgresql+psycopg://payment_service:payment_service@payment-db:5432/payment_service

# Product DB (MongoDB)
MONGO_URL=mongodb://product_mongo:27017
MONGO_DB=product_service

# Notification DB (PostgreSQL)
NOTIFICATION_DB_URL=postgresql+psycopg://notification_service:notification_service@notification-db:5432/notification_service

# SMTP (MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@women-shop.local

# سرویس‌ها
USER_SERVICE_URL=http://user-service:8000
PRODUCT_SERVICE_URL=http://product-service:8000
PAYMENT_SERVICE_URL=http://payment-service:8000

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=orders
RABBITMQ_QUEUE=order_events
